MIGRATION_DIR="/home/anoop/works/phpmono/pkgs/php-sqlrun/tests/sqlite"
SQLITE_DBFILE="/home/anoop/works/phpmono/pkgs/php-sqlrun/tests/.sqlite"

# mariadb-first
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USERNAME=root
MARIADB_PASSWORD=password
MARIADB_DBNAME=sqlrun

# always forward everything from mariadb
MYSQL_HOST=${MARIADB_HOST}
MYSQL_PORT=${MARIADB_PORT}
MYSQL_USERNAME=${MARIADB_USERNAME}
MYSQL_PASSWORD=${MARIADB_PASSWORD}
MYSQL_DBNAME=${MARIADB_DBNAME}

# postgresql
PGSQL_HOST=localhost
PGSQL_PORT=5432
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=password
PGSQL_DBNAME=sqlrun

# Laravel uses mariadb vars
LARAVEL_DRIVER=mariadb
LARAVEL_HOST=${MARIADB_HOST}
LARAVEL_PORT=${MARIADB_PORT}
LARAVEL_USERNAME=${MARIADB_USERNAME}
LARAVEL_PASSWORD=${MARIADB_PASSWORD}
LARAVEL_DBNAME=${MARIADB_DBNAME}

# Yii2 uses mysql vars (no mariadb driver)
YII2_DRIVER=mysql
YII2_HOST=${MYSQL_HOST}
YII2_PORT=${MYSQL_PORT}
YII2_USERNAME=${MYSQL_USERNAME}
YII2_PASSWORD=${MYSQL_PASSWORD}
YII2_DBNAME=${MYSQL_DBNAME}